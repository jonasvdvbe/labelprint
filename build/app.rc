1 ICON "app.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "LabelPrint"
      VALUE "FileDescription", "LabelPrint - print shipping labels from PDF to label printers"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "LabelPrint"
      VALUE "OriginalFilename", "LabelPrint.exe"
      VALUE "ProductName", "LabelPrint"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
